@article{Lp_estimates_PERAL,
title = {Lp estimates for the wave equation},
journal = {Journal of Functional Analysis},
volume = {36},
number = {1},
pages = {114-145},
year = {1980},
issn = {0022-1236},
doi = {https://doi.org/10.1016/0022-1236(80)90110-X},
url = {https://www.sciencedirect.com/science/article/pii/002212368090110X},
author = {Juan C. Peral},
abstract = {Let u(x, t) be the solution of utt − Δxu = 0 with initial conditions u(x, 0) = g(x) and ut(x, 0) = ƒ;(x). Consider the linear operator T: ƒ; → u(x, t). (Here g = 0.) We prove for t fixed the following result. Theorem 1: T is bounded in Lp if and only if ¦ p−1 − 2−1 ¦ = (n − 1)−1 and ∥ Tƒ; ∥LαP = ∥ƒ;∥LP with α = 1 −(n − 1) ¦ p−1 − 2−1 ¦. Theorem 2: If the coefficients are variables in C and constant outside of some compact set we get: (a) If n = 2k the result holds for ¦ p−1 − 2−1 ¦ < (n − 1)−1. (b) If n = 2k − 1, the result is valid for ¦ p−1 − 2−1 ¦ ⩽ (n − 1). This result are sharp in the sense that for p such that ¦ p−1 − 2−1 ¦ > (n − 1)−1 we prove the existence of ƒ; ϵ LP in such a way that Tƒ; ∉ LP. Several applications are given, one of them is to the study of the Klein-Gordon equation, the other to the completion of the study of the family of multipliers m(ξ) = ψ(ξ) ei¦ξ¦ ¦ ξ ¦ −b and finally we get that the convolution against the kernel K(x) = ϑ(x)(1 − ¦ x ¦)−1 is bounded in H1.}
}

